# ========================================================
# Shoply 运行环境配置文件模板 (.env)
# 首次运行前请复制为 .env 并根据实际情况修改安全密钥
# cp .env.example .env
# ========================================================

# --------------------------------------------------------
# 镜像源与版本配置
# --------------------------------------------------------
# 国内环境推荐使用阿里云公开镜像源（无需翻墙，高速拉取）：
# SHOPLY_IMAGE_REGISTRY=crpi-vvvid8bdlzbcxo4s.cn-shenzhen.personal.cr.aliyuncs.com
# 海外环境推荐使用 GitHub Container Registry：
# SHOPLY_IMAGE_REGISTRY=ghcr.io
SHOPLY_IMAGE_REGISTRY=crpi-vvvid8bdlzbcxo4s.cn-shenzhen.personal.cr.aliyuncs.com
SHOPLY_IMAGE_NAME=hoxiai/shoply
SHOPLY_VERSION=latest

# 宿主机映射对外暴露端口 (默认 5490)
SHOPLY_HTTP_PORT=5490

# --------------------------------------------------------
# 站点与初始管理员账户 (仅首次初始化数据库时生效)
# --------------------------------------------------------
SHOPLY_STORE_NAME=Shoply Store
# 访问 URL，生产部署请填写实际完整域名（例如 https://mall.example.com）
SHOPLY_SITE_URL=http://localhost:5490
# 初始超级管理员登录邮箱
SHOPLY_SITE_EMAIL=admin@shoply.page
# 初始超级管理员密码（务必修改为强密码，长度至少 8 位）
SHOPLY_SITE_PASSWORD=AdminPassword123!

# --------------------------------------------------------
# 安全与 JWT 签名密钥 (生产环境务必更改为随机高强度字符串)
# --------------------------------------------------------
# 签名密钥 (至少 16 位字符)
SHOPLY_JWT_SIGN_KEY=change_this_to_random_jwt_sign_key_16_chars!
# 加密私钥 (建议 32 位随机字符)
SHOPLY_JWT_SECRET_KEY=change_this_to_random_jwt_secret_key_32_chars!
SHOPLY_JWT_ADMIN_PERMISSION_MODE=enforce

# --------------------------------------------------------
# 数据库配置 (内置 MySQL 服务)
# --------------------------------------------------------
SHOPLY_DB_DRIVER=mysql
SHOPLY_DB_HOST=mysql
SHOPLY_DB_PORT=3306
SHOPLY_DB_DATABASE=shoply
SHOPLY_DB_USERNAME=shoply
# MySQL 普通用户密码（请修改）
SHOPLY_DB_PASSWORD=shoply_db_password_change_me
# MySQL Root 管理员密码（请修改）
SHOPLY_MYSQL_ROOT_PASSWORD=shoply_mysql_root_password_change_me

# --------------------------------------------------------
# 缓存配置 (内置 Redis 服务)
# --------------------------------------------------------
SHOPLY_REDIS_ADDR=redis:6379
# Redis 访问密码（请修改）
SHOPLY_REDIS_PASSWORD=shoply_redis_password_change_me
SHOPLY_REDIS_DB=0
