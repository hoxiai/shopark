# ========================================================
# Shoply Release 镜像构建忽略规则
# ========================================================

**/.git
**/.git/**
**/.gitignore
**/.DS_Store
**/.DS_Store/**

.env
*.tar.gz
*.tmp*

**/node_modules
**/node_modules/**
**/.vite
**/.vite/**

# 仅保留 Common 与 Mall 两个官方核心内置应用供自愈释放
plugins/app/*
!plugins/app/.gitkeep
!plugins/app/Common/
!plugins/app/Common/**
!plugins/app/Mall/
!plugins/app/Mall/**

template/themes/*
!template/themes/default/
!template/themes/default/**
template/themes/**/md/
template/themes/**/md/**

plugins/vendor/**/.git
plugins/vendor/**/.git/**
plugins/vendor/phpunit/
plugins/vendor/phpunit/**
