# ========================================================
# Shopark Release 镜像构建忽略规则
# ========================================================

**/.git
**/.git/**
**/.gitignore
**/.DS_Store
**/.DS_Store/**

.env
*.tar.gz
*.tmp*

**/node_modules
**/node_modules/**
**/.vite
**/.vite/**

# 应用：默认不打包任何应用进入镜像（保持镜像纯净，应用通过挂载或应用市场安装）
plugins/app/*
!plugins/app/.gitkeep

template/themes/*
!template/themes/default/
!template/themes/default/**
template/themes/**/md/
template/themes/**/md/**

# 归档中的 vendor 已按 composer.lock 去掉开发依赖，不要再按目录删包（autoload 会引用失败）
plugins/vendor/**/.git
plugins/vendor/**/.git/**

# 放在最后，覆盖上面的放行
**/.git
**/.git/**
**/.DS_Store
